{
  // Dev, build, and deploy read cloudflare.config.ts (ADR 0005). This file
  // stays for `wrangler tail`, `wrangler secret put`, and `wrangler types`.
  // Keep it in step with cloudflare.config.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japan-trip-december-2026",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // The app's stable address. Worker-level Access protects it (#14).
  "workers_dev": true,
  "preview_urls": false,
  // All editable data lives in one SQLite-backed Durable Object (ADR 0001),
  // declared under exports, never the legacy migrations list.
  "durable_objects": {
    "bindings": [{ "name": "TRIP_STORE", "class_name": "TripStore" }],
  },
  // The Detail tiles archive, which the Worker serves tile by tile behind the
  // Access gate. `vp run seed-local-tiles` fills the local bucket.
  "r2_buckets": [
    { "binding": "DETAIL_TILES", "bucket_name": "japan-trip-detail-tiles" },
  ],
  "exports": {
    "TripStore": { "type": "durable-object", "storage": "sqlite" },
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://phillip-hirsch.cloudflareaccess.com",
    "ACCESS_AUD": "4a42be9cb2b73a1d0fec42fcf0e6523227a9e4a988fffd69b689b012cfebdf16",
    "ACCESS_ALLOWED_EMAIL": "phillip@350home.com",
  },
  // Matches worker.access.dev in cloudflare.config.ts. Wrangler reads this
  // file; cf dev reads cloudflare.config.ts. The gate uses ctx.access only
  // when .dev.vars sets ACCESS_DEV_SIMULATION, which production never does.
  "access": {
    "dev": {
      "aud": "4a42be9cb2b73a1d0fec42fcf0e6523227a9e4a988fffd69b689b012cfebdf16",
      "identity": { "email": "phillip@350home.com" },
    },
  },
}
