# Local-only Access gate values for `vp dev` and `vp preview`; never deployed.
# ACCESS_AUD matches access.dev.aud in wrangler.jsonc. No secrets belong here.
ACCESS_TEAM_DOMAIN=https://local-dev.cloudflareaccess.com
ACCESS_AUD=local-dev-aud
# Lets the gate accept Wrangler's Access dev simulation, which sends no token.
ACCESS_DEV_SIMULATION=true
