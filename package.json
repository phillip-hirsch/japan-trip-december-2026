{
  "name": "japan-trip-december-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "vite": "vp",
    "generate-routes": "tsr generate",
    "build": "cf build",
    "preview": "vp preview",
    "deploy": "cf build && cf deploy --prebuilt --mode production",
    "cf-typegen": "wrangler types",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint && node -e \"fs.existsSync('.dev.vars') || fs.copyFileSync('.dev.vars.example', '.dev.vars')\"",
    "lint": "vp lint",
    "format": "vp fmt .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "subset-display-font": "node scripts/subset-display-font.ts",
    "build-rail-geometry": "node scripts/build-rail-geometry.ts",
    "build-map-assets": "node scripts/build-map-assets.ts",
    "build-map-tiles": "node scripts/build-map-tiles.ts",
    "seed-local-tiles": "cf r2 objects put detail.pmtiles --bucket-name japan-trip-detail-tiles --file tiles/detail-local.pmtiles --local --persist-to .cloudflare/state",
    "upload-tiles": "cf r2 objects put detail.pmtiles --bucket-name japan-trip-detail-tiles --file tiles/detail.pmtiles",
    "build-app-manifest": "node scripts/build-app-manifest.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@effect/sql-sqlite-do": "4.0.6",
    "@protomaps/basemaps": "5.7.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "effect": "4.0.6",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serwist": "9.5.13",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.0",
    "@effect/sql-sqlite-node": "4.0.6",
    "@effect/tsgo": "0.57.0",
    "@effect/vitest": "4.0.6",
    "@serwist/build": "9.5.13",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.46",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.23",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "oxc-transform-react": "^0.155.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.152.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.1 || ^24.11.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0",
      "onFail": "download"
    }
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
